#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#
comment "Infineon Aurix TC3XX Family configurations"

choice
        prompt "Infineon Aurix TC3XX Chip selection"
        default TC3XX_CHIP_TC397

config TC3XX_CHIP_TC397
        bool "TC397 SoC"
        ---help---
                TC397 SoC

config TC3XX_CHIP_TC375
        bool "TC375 SoC"
        ---help---
                TC375 SoC

endchoice

config ARCH_TRICORE_CPU_COUNT
	int "TRICORE CPU count"
	default 1
	---help---
		Tricore CPU count

menu "TC3XX Peripheral Support"

# UART
config TRICORE_UART0
        bool "ASCLIN0 UART"
        default n
        select UART0_SERIALDRIVER
        select SERIAL
        ---help---
                Enable the ASCLIN0 peripheral as a UART serial port.

if TRICORE_UART0

config TRICORE_UART0_RXIRQ
        int "ASCLIN0 RX IRQ number"
        default 21

config TRICORE_UART0_TXIRQ
        int "ASCLIN0 TX IRQ number"
        default 20

config TRICORE_UART0_ERIRQ
        int "ASCLIN0 ERR IRQ number"
        default 22

config TRICORE_ASCLINF_FREQUENCY
        int "fASCLINF clock frequency (Hz)"
        default 100000000

endif # TRICORE_UART0

# I2C
menuconfig TC3XX_I2C
        bool "TC3xx I2C Master Driver"
        default n
        depends on I2C
        select ARCH_HAVE_I2CRESET
        ---help---
                Enable I2C master driver for Infineon Aurix TC3xx.

if TC3XX_I2C

config TC3XX_I2C_CLOCK_FREQ
        int "I2C peripheral source clock in Hz"
        default 100000000
        ---help---
                The I2C clock frequency from the CCU. Check your clock
                tree configuration. Default assumes 100 MHz.

config TC3XX_I2C0
        bool "Enable I2C0"
        default n

if TC3XX_I2C0

config TC3XX_I2C0_FREQUENCY
        int "I2C0 default bus frequency"
        default 100000
        ---help---
                Default I2C bus speed in Hz.
                standard mode (100 kHz)
                fast mode (400 kHz)

config TC3XX_I2C0_PISEL
        int "I2C0 pin input select"
        default 1
        range 0 7
        ---help---
                Selects which port pins provide SDA/SCL input signals.

endif # TC3XX_I2C0

config TC3XX_I2C1
        bool "Enable I2C1"
        default n

if TC3XX_I2C1

config TC3XX_I2C1_FREQUENCY
        int "I2C1 default bus frequency"
        default 100000

config TC3XX_I2C1_PISEL
        int "I2C1 pin input select"
        default 0
        range 0 7

endif # TC3XX_I2C1

config TC3XX_I2C2
        bool "Enable I2C2"
        default n

if TC3XX_I2C2

config TC3XX_I2C2_FREQUENCY
        int "I2C2 default bus frequency"
        default 100000

config TC3XX_I2C2_PISEL
        int "I2C2 pin input select"
        default 0
        range 0 7

endif # TC3XX_I2C2

endif # TC3XX_I2C

# GETH
menuconfig TC3XX_GETH
	bool "Infineon Tricore GETH support"
	default n
	depends on NET_DWXGMAC
	---help---
		Enable Infineon Tricore GETH support

if TC3XX_GETH

config TRICORE_GETH_BASE
    hex "Tricore GETH base address"
    default 0xf001f000

config TRICORE_GETH_PHY_MODE
    int "GETH PHY interface mode (GPCTL.EPR)"
    default 1
    ---help---
        PHY interface mode written to GETH_GPCTL.EPR:
        0 = MII, 1 = RGMII, 4 = RMII.

config TRICORE_GETH_GPCTL_ALTI
    hex "GETH GPCTL input alternate selects"
    default 0x1
    ---help---
        Raw value for the GETH_GPCTL input select fields (bits 21:0).
        Each GETH input signal has a 2-bit select choosing the input
        pad alternative A(0)/B(1)/C(2)/D(3); bits 1:0 select the MDIO
        input pad.  E.g. 0x1 routes MDIO from alternative B (TC397
        TFT, P12.1), 0x3 from alternative D (TC375 lite kit, P21.3).

endif # TC3XX_GETH

# QSPI (Synchronous Serial Interface) -- TC3xx hardware QSPI block
menuconfig TC3XX_QSPI
	bool "TC3xx QSPI master driver"
	default n
	depends on SPI
	---help---
		Enable the polled-mode QSPI master driver for the TC3xx (TC397)
		family.  Provides a NuttX spi_ops_s lower-half built on top of
		the dedicated QSPI peripheral with hardware SLSO chip selects.

if TC3XX_QSPI

config TC3XX_QSPI_FSPB_HZ
	int "fSPB clock feeding the QSPI module (Hz)"
	default 100000000
	---help---
		Source clock frequency that drives the QSPI peripheral.  TC397
		runs fSPB at 100 MHz by default; adjust to match your clock-tree
		configuration.

config TC3XX_QSPI2
	bool "Enable QSPI2"
	default n
	---help---
		Enable QSPI2 as a NuttX SPI bus.  On the TC397 ADAS Kit, QSPI2
		is wired to the TLF30682QVS01 PMIC via SLSO1 with MTSR=P15.6,
		MRST=P15.7, SCLK=P15.8, SLSO1=P14.2 (all ALT3).

if TC3XX_QSPI2

config TC3XX_QSPI2_DEFAULT_CS
	int "Default hardware CS (SLSO index, 0..15)"
	default 1
	range 0 15
	---help---
		Default SLSO line driven by the QSPI2 module.  TLF30682 on the
		TC397 ADAS Kit uses SLSO1.

endif # TC3XX_QSPI2

config TC3XX_QSPI3
	bool "TC3xx QSPI3 module"
	default n
	---help---
		Enable the QSPI3 module driver. On the A2G-TC397XA-3V3-TFT board
		QSPI3 is wired out via header X103 (P02.5/6/7/8) for external
		SPI peripherals.

config TC3XX_QSPI3_DEFAULT_CS
	int "TC3xx QSPI3 default SLSO index"
	depends on TC3XX_QSPI3
	range 0 15
	default 0
	---help---
		Hardware SLSO index used for the default chip select. For the
		W25Q128JV flash wired to P02.8, this is SLSO0 (= 0).

endif # TC3XX_QSPI

# WDT
config TC3XX_WDT
	bool "TC3xx Watchdog Timer driver"
	default n
	depends on WATCHDOG
	---help---
		Enable the TC3xx CPU watchdog timer driver.  Registers
		/dev/watchdog0 backed by SCU.WDTCPU0_CON0/CON1/SR.

		WDT overflow generates an alarm to the SMU.  Until the
		TC3xx SMU integration is in place, an overflow will not
		automatically issue a chip reset; feed/start/stop/status
		paths still work for development use.

config TC3XX_WDT_FSPB
	int "SPB clock frequency (Hz) feeding the TC3xx WDT"
	default 100000000
	depends on TC3XX_WDT
	---help---
		Source clock for the WDT divider chain.  TC397 runs fSPB at
		100 MHz by default; adjust to match your clock-tree.

endmenu
