# include common/Make.defs

CHIP_CSRCS += tc4x_clockconfig.c
CHIP_CSRCS += tc4x_wdt.c
CHIP_CSRCS += tc4xx_endinit.c
CHIP_CSRCS += tc4xx_gpio.c

ifeq ($(CONFIG_TC4X_SMU),y)
CHIP_CSRCS += tc4x_smu.c
CFLAGS += -I$(TOPDIR)/drivers/misc
endif

ifeq ($(CONFIG_TC4XX_I2C),y)
CHIP_CSRCS += tc4xx_i2c.c
endif

ifeq ($(CONFIG_TC4XX_GETH),y)
CHIP_CSRCS += tc4x_geth.c
ifeq ($(CONFIG_TRICORE_GETH_IF_SGMII),y)
CHIP_CSRCS += tc4x_xpcs.c
endif
endif

ifeq ($(CONFIG_TC4XX_LETH),y)
CHIP_CSRCS += tc4x_leth.c
endif

# QSPI
ifeq ($(CONFIG_TC4XX_QSPI),y)
CHIP_CSRCS += tc4x_qspi.c
endif

# SPI
ifeq ($(CONFIG_TC4XX_ASCLIN_SPI),y)
CHIP_CSRCS += tc4xx_asclin_spi.c
endif

# XSPI
ifeq ($(CONFIG_TC4XX_XSPI),y)
CHIP_CSRCS += tc4x_xspi.c
ifneq ($(CONFIG_TC4XX_XSPI_PORTSEL_GPIO),y)
CHIP_CSRCS += tc4x_hsphy.c
endif
endif

# eGTM
ifeq ($(CONFIG_TC4XX_EGTM_PWM),y)
CHIP_CSRCS += tc4xx_egtm.c
endif

ifeq ($(CONFIG_TC4XX_EGTM_PWM_LOWERHALF),y)
CHIP_CSRCS += tc4xx_egtm_pwm.c
endif

# GPT12 PWM
ifneq ($(filter y, $(CONFIG_TC4XX_GPT1_PWM) $(CONFIG_TC4XX_GPT2_PWM)),)
CHIP_CSRCS += tc4xx_gpt12_pwm.c
endif
