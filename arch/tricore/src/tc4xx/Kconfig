# LETH
menuconfig TC4XX_LETH
	bool "Infineon Tricore LETH support"
	default n
	depends on NET_DWXGMAC
	---help---
		Enable Infineon Tricore Lite Ethernet (LETH) support.  LETH
		wraps the same DesignWare Ethernet-QoS MAC as GETH but drives
		an external 10/100 RMII PHY directly through the port pads.

if TC4XX_LETH

config TRICORE_LETH_BASE
    hex "Tricore LETH base address"
    default 0xf9400000

endif # TC4XX_LETH

config TC4XX_XSPI
	bool "xSPI controller"
	default n
	select XSPI
	select XSPI_DW_SSI
	select XSPI_DW_SSI_HAS_DDR
	select XSPI_DW_SSI_HAS_HYPERBUS
	select XSPI_DW_SSI_HAS_DMA
	select XSPI_DW_SSI_HAS_XIP
	---help---
		Enable the TC4xx xSPI controller. Provides SoC glue around
		the Synopsys DWC_SSI IP core driver for the single xSPI
		instance on TC4Dx devices.

if TC4XX_XSPI

config TC4XX_XSPI_SSI_CLK_HZ
	int "xSPI SSI_clk rate (Hz)"
	default 100000000
	---help---
		Input SSI_clk frequency feeding the xSPI controller. Used by
		the IP driver to compute the BAUDR divider. The default is a
		placeholder; set from the board clock tree.

config TC4XX_XSPI_PORTSEL_GPIO
	bool "Route via GPIO pads (port 20) instead of HSFAST (port 16)"
	default n
	---help---
		Select GPIO pad routing for reduced functionality mode:
		SDR only, quad max, 25 MHz max, 3 V devices only.
		Useful for early bring-up on boards that expose port 20 pins
		on headers. Clear this for production HSFAST routing.

endif # TC4XX_XSPI

endmenu

# QSPI
menuconfig TC4XX_QSPI
	bool "TC4xx QSPI master driver"
	default n
	depends on SPI
        select SPI_DRIVER
        select SPI_EXCHANGE
        ---help---
                Enable the polled-mode QSPI master driver for TC4Dx.
                Provides a NuttX spi_ops_s lower-half built on top of the
                dedicated QSPI peripheral with hardware SLSO chip selects.
                Automatically enables the SPI character driver (/dev/spiN)
                and the spi_exchange() transfer operation.

if TC4XX_QSPI

config TC4XX_QSPI_FPER_HZ
        int "fPER clock feeding the QSPI module (Hz)"
        default 200000000
        ---help---
                Peripheral PLL clock frequency driving the QSPI module.
                TC4Dx boards typically run fPER at 200 MHz via the PER PLL
                (PERCCUCON0.CLKSELQSPI=2, QSPIDIV=1).  Adjust if a different
                clock source or divider is configured in tc4x_clockconfig.c.

if TC4XX_QSPI0
config TC4XX_QSPI0_DEFAULT_CS
	int "QSPI0 default hardware CS (SLSO index)"
	default 0
	range 0 15
config TC4XX_QSPI0_MRIS
	int "QSPI0 MRIS pin input select"
	default 0
	range 0 7
config TC4XX_QSPI0_TXIRQ
	int "QSPI0 TX interrupt node index (IRQ_QSPI0_TX)"
	default 280
config TC4XX_QSPI0_RXIRQ
	int "QSPI0 RX interrupt node index (IRQ_QSPI0_RX)"
	default 281
config TC4XX_QSPI0_ERIRQ
	int "QSPI0 Error interrupt node index (IRQ_QSPI0_ERR)"
	default 282
endif # TC4XX_QSPI0

