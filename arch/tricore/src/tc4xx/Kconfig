	int "I2C1 pin input select"
	default 0
	range 0 7

endif # TC4XX_I2C1

config TC4XX_I2C2
	bool "Enable I2C2"
	default n

if TC4XX_I2C2

config TC4XX_I2C2_FREQUENCY
	int "I2C2 default bus frequency"
	default 100000

