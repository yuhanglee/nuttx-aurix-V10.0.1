# SPI
config TC4XX_ASCLIN_SPI
	bool "ASCLIN SPI master support"
	default n
	depends on SPI
	---help---
		Enable SPI master mode on ASCLIN modules.  The ASCLIN IP supports
		UART, LIN, and SPI modes.  This option enables the SPI lower-half
		driver that implements the NuttX spi_ops_s interface.

		Chip select is managed via GPIO, not the hardware ASLSO signal.
		Each bus instance requires its own ASCLIN module (separate from
		any ASCLIN used for UART console).

if TC4XX_ASCLIN_SPI

config TC4XX_ASCLIN3_SPI
	bool "ASCLIN3 as SPI bus 0 (mikroBUS pins)"
	default y
	---help---
		Use ASCLIN3 for SPI bus 0.  On a3g-tc4d7-lite this is wired to
		the mikroBUS connector SPI pins (verified against iLLD
		IfxAsclin_PinMap_TC4Dx_BGA292_COM):

		  MOSI: P15.6 (ASCLIN3.TX, ALT2)   - mikroBUS pin 6
		  MISO: P15.7 (ASCLIN3.RXA)        - mikroBUS pin 5
		  SCLK: P15.8 (ASCLIN3.SCLK, ALT6) - mikroBUS pin 4
		  CS:   P14.7 (GPIO)               - mikroBUS pin 3

		ASCLIN3 has no SLSO line on a header-accessible pin, so CS is
		driven as a plain GPIO from the SPI driver's select callback.

config TC4XX_ASCLIN3_SPI_LOOPBACK
	bool "Enable loopback on ASCLIN3 SPI"
	default n
	depends on TC4XX_ASCLIN3_SPI
	---help---
		Enable internal loopback (IOCR.LB) for ASCLIN3 SPI.  TX is
		internally connected to RX.  Useful for driver validation
		without external wiring.  Disable for real hardware use.

config TC4XX_ASCLIN_SPI_CHARDEV
	bool "Register SPI character device"
	default y
	depends on SPI_DRIVER
	---help---
		Register /dev/spiN character device via spi_register().
		Enables userspace access through standard SPI ioctls.

endif # TC4XX_ASCLIN_SPI

# eGTM
menuconfig TC4XX_EGTM_PWM
	bool "TC4XX eGTM PWM (TOM0)"
	default n
	---help---
		Enable the eGTM TOM0 PWM HAL (CLC + CMU + TOM + TGC + ICM).
		Provides the tc4xx_egtm_* C API. Select the lower-half option
		below to also expose /dev/pwmN via the NuttX standard PWM
		framework.

if TC4XX_EGTM_PWM

config TC4XX_EGTM_TOM0_CH
	int "TOM0 PWM channel (0..7)"
	default 0
	range 0 7
	---help---
		Which TOM0 channel the lower-half adapter and board bringup
		drive by default.

config TC4XX_EGTM_PWM_LOWERHALF
	bool "Register NuttX standard PWM driver (/dev/pwmN)"
	default n
	select PWM
	---help---
		Wraps the eGTM HAL behind the NuttX pwm_ops_s vtable so the
		channel is reachable via the upper-half PWM character driver
		(open("/dev/pwm0") + PWMIOC_* ioctls). The board bringup must
		call pwm_register("/dev/pwm0", tc4xx_egtm_pwm_initialize(0)).

if TC4XX_EGTM_PWM_LOWERHALF

config TC4XX_EGTM_PWM_GCLK_DEN
	int "CMU GCLK_DEN (GCLK = feGTM / DEN)"
	default 1
	range 1 16777215
	---help---
		CMU divider for GCLK. Some TC4xx silicon revisions reject
		writes to GCLK_DEN other than 1 (lock layer not yet
		identified). Leave at 1; the driver auto-selects the FXCLK
		tap per requested frequency.

endif # TC4XX_EGTM_PWM_LOWERHALF

endif # TC4XX_EGTM_PWM
