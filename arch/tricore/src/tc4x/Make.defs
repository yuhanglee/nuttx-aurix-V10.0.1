CHIP_CSRCS += tc4x_clockconfig.c
CHIP_CSRCS += tc4x_gpio.c

ifeq ($(CONFIG_TC4X_SMU),y)
CHIP_CSRCS += tc4x_smu.c
CFLAGS += -I$(TOPDIR)/drivers/misc
endif
CHIP_CSRCS += tc4x_watchdog.c

ifeq ($(CONFIG_TC4X_I2C),y)
CHIP_CSRCS += tc4x_i2c.c
endif

ifeq ($(CONFIG_TC4X_QSPI),y)
CHIP_CSRCS += tc4x_qspi.c
endif

# XSPI
ifeq ($(CONFIG_TC4X_XSPI),y)
CHIP_CSRCS += tc4x_xspi.c
ifneq ($(CONFIG_TC4X_XSPI_PORTSEL_GPIO),y)
CHIP_CSRCS += tc4x_hsphy.c
endif
endif

# SPI
ifeq ($(CONFIG_TC4X_ASCLIN_SPI),y)
CHIP_CSRCS += tc4x_asclin_spi.c
endif


# eGTM
ifeq ($(CONFIG_TC4X_EGTM_PWM),y)
CHIP_CSRCS += tc4x_egtm.c
endif

ifeq ($(CONFIG_TC4X_EGTM_PWM_LOWERHALF),y)
CHIP_CSRCS += tc4x_egtm_pwm.c
endif

# GPT12 PWM
ifneq ($(filter y, $(CONFIG_TC4X_GPT1_PWM) $(CONFIG_TC4X_GPT2_PWM)),)
CHIP_CSRCS += tc4x_gpt12_pwm.c
endif

# AUDIO TDM / I2S (TC48x only)
ifeq ($(CONFIG_TC4X_I2S),y)
CHIP_CSRCS += tc4x_i2s.c
endif

VPATH += tc4x
