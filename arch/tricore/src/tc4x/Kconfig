config TC4X_QSPI4
	bool "Enable QSPI4 (mikroBUS SPI header)"
	default n
	---help---
		Enable QSPI4.  On the a3g-tc4d7-lite board QSPI4 is wired
                to the SEMPER Flash / mikroBUS SPI header:
                MOSI=P22.0 (QSPI4_MTSR_F, ALT3),
                MISO=P22.1 (QSPI4_MRSTB_F, MRIS=1, input),
                SCLK=P22.3 (QSPI4_SCLK_F, ALT3),
                CS=SLSO6 (P23.1, ALT3).

if TC4X_QSPI4
config TC4X_QSPI4_DEFAULT_CS
        int "QSPI4 default hardware CS (SLSO index)"
        default 6
        range 0 15
config TC4X_QSPI4_MRIS
        int "QSPI4 MRIS pin input select"
        default 1
        range 0 7
config TC4X_QSPI4_LOOPBACK
        bool "Enable internal loopback on QSPI4"
        default n
        ---help---
                Enable GLOBALCON.LB to internally connect MTSR to MRST.
                Use this for spi_test /dev/spi1 without an external
                MOSI->MISO jumper wire.
config TC4X_QSPI4_TXIRQ
	int "QSPI4 TX interrupt node index (IRQ_QSPI4_TX)"
	default 300
config TC4X_QSPI4_RXIRQ
	int "QSPI4 RX interrupt node index (IRQ_QSPI4_RX)"
	default 301
config TC4X_QSPI4_ERIRQ
	int "QSPI4 Error interrupt node index (IRQ_QSPI4_ERR)"
	default 302
endif # TC4X_QSPI4

