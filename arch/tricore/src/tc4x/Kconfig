config TC4X_XSPI
	bool "xSPI controller"
	default n
	select XSPI
	select XSPI_DW_SSI
	select XSPI_DW_SSI_HAS_DDR
	select XSPI_DW_SSI_HAS_HYPERBUS
	select XSPI_DW_SSI_HAS_DMA
	select XSPI_DW_SSI_HAS_XIP
	---help---
		Enable the TC4xx xSPI controller. Provides SoC glue around
		the Synopsys DWC_SSI IP core driver for the single xSPI
		instance on TC4Dx devices.

if TC4X_XSPI

config TC4X_XSPI_SSI_CLK_HZ
	int "xSPI SSI_clk rate (Hz)"
	default 100000000
	---help---
		Input SSI_clk frequency feeding the xSPI controller. Used by
		the IP driver to compute the BAUDR divider. The default is a
		placeholder; set from the board clock tree.

config TC4X_XSPI_PORTSEL_GPIO
	bool "Route via GPIO pads (port 20) instead of HSFAST (port 16)"
	default n
	---help---
		Select GPIO pad routing for reduced functionality mode:
		SDR only, quad max, 25 MHz max, 3 V devices only.
		Useful for early bring-up on boards that expose port 20 pins
		on headers. Clear this for production HSFAST routing.

endif # TC4X_XSPI

# SPI
config TC4X_ASCLIN_SPI
	bool "ASCLIN SPI master support"
	default n
	depends on SPI
	---help---
		Enable SPI master mode on ASCLIN modules.  The ASCLIN IP supports
		UART, LIN, and SPI modes.  This option enables the SPI lower-half
		driver that implements the NuttX spi_ops_s interface.

		Chip select is managed via GPIO, not the hardware ASLSO signal.
		Each bus instance requires its own ASCLIN module (separate from
		any ASCLIN used for UART console).

if TC4X_ASCLIN_SPI

config TC4X_ASCLIN3_SPI
	bool "ASCLIN3 as SPI bus 0 (mikroBUS pins)"
	default y
	---help---
		Use ASCLIN3 for SPI bus 0.  On a3g-tc4d7-lite this is wired to
		the mikroBUS connector SPI pins (verified against iLLD
		IfxAsclin_PinMap_TC4Dx_BGA292_COM):

		  MOSI: P15.6 (ASCLIN3.TX, ALT2)   - mikroBUS pin 6
		  MISO: P15.7 (ASCLIN3.RXA)        - mikroBUS pin 5
		  SCLK: P15.8 (ASCLIN3.SCLK, ALT6) - mikroBUS pin 4
		  CS:   P14.7 (GPIO)               - mikroBUS pin 3

		ASCLIN3 has no SLSO line on a header-accessible pin, so CS is
		driven as a plain GPIO from the SPI driver's select callback.

config TC4X_ASCLIN3_SPI_LOOPBACK
	bool "Enable loopback on ASCLIN3 SPI"
	default n
	depends on TC4X_ASCLIN3_SPI
	---help---
		Enable internal loopback (IOCR.LB) for ASCLIN3 SPI.  TX is
		internally connected to RX.  Useful for driver validation
		without external wiring.  Disable for real hardware use.

config TC4X_ASCLIN_SPI_CHARDEV
	bool "Register SPI character device"
	default y
	depends on SPI_DRIVER
	---help---
		Register /dev/spiN character device via spi_register().
		Enables userspace access through standard SPI ioctls.

endif # TC4X_ASCLIN_SPI


# eGTM
menuconfig TC4X_EGTM_PWM
	bool "TC4X eGTM PWM (TOM)"
	default n
	---help---
		Enable the eGTM TOM PWM HAL (CLC + CMU + TOM + TGC + ICM).
		Provides the tc4x_egtm_* C API. Select the lower-half option
		below to also expose /dev/pwmN via the NuttX standard PWM
		framework.

if TC4X_EGTM_PWM

config TC4X_EGTM_PWM_LOWERHALF
	bool "Register NuttX standard PWM driver (/dev/pwmN)"
	default n
	select PWM
	---help---
		Wraps the eGTM HAL behind the NuttX pwm_ops_s vtable so the
		channels are reachable via the upper-half PWM character
		driver (open("/dev/pwm<minor>") + PWMIOC_* ioctls). The
		board bringup must call tc4x_egtm_pwm_register() once per
		/dev/pwmN node.

if TC4X_EGTM_PWM_LOWERHALF

config TC4X_EGTM_PWM_GCLK_DEN
	int "CMU GCLK_DEN (GCLK = feGTM / DEN)"
	default 1
	range 1 16777215
	---help---
		CMU divider for GCLK. Leave at 1; the driver runs the TOM
		off the fixed FXCLK tap 0 (tick = feGTM / 2).

endif # TC4X_EGTM_PWM_LOWERHALF

endif # TC4X_EGTM_PWM

# GPT12 PWM — shared instance base address
config TC4X_GPT120_BASE
	hex "GPT12 instance base address"
	default 0xF0020000
	depends on TC4X_GPT1_PWM || TC4X_GPT2_PWM
	---help---
		Base address of the GPT12 instance used for PWM.
		GPT120=0xF0020000, GPT121=0xF0020200,
		GPT122=0xF0020400, GPT123=0xF0020600.

# GPT12 PWM (GPT1 block: T2/T3/T4)
menuconfig TC4X_GPT1_PWM
	bool "TC4xx GPT1 PWM output (T2/T3/T4)"
	default n
	depends on PWM
	---help---
		Enable GPT1-block PWM on /dev/pwm0.
		Uses T3 as core timer, T2/T4 for high/low-phase reload.

if TC4X_GPT1_PWM

config TC4X_GPT1_PWM_T3_SRN
	int "GPT12 T3 overflow SRN index"
	default 1410
	---help---
		NuttX IRQ number for the T3 overflow interrupt.
		GPT120=1410, GPT121=1416, GPT122=1422, GPT123=1428.

endif # TC4X_GPT1_PWM

# GPT12 PWM (GPT2 block: T6/CAPREL)
menuconfig TC4X_GPT2_PWM
	bool "TC4xx GPT2 PWM output (T6/CAPREL)"
	default n
	depends on PWM
	---help---
		Enable GPT2-block PWM on /dev/pwm1.
		Uses T6 as core timer with CAPREL reload on overflow.

if TC4X_GPT2_PWM

config TC4X_GPT2_PWM_T6_SRN
	int "GPT12 T6 overflow SRN index"
	default 1413
	---help---
		NuttX IRQ number for the T6 overflow interrupt.
		GPT120=1413, GPT121=1419, GPT122=1425, GPT123=1431.

endif # TC4X_GPT2_PWM
