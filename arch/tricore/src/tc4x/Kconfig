#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

comment "Infineon AURIX TC4X Chip"

choice
	prompt "Infineon AURIX TC4X Chip selection"
	default TC4X_CHIP_TC4D7

config TC4X_CHIP_TC4D7
	bool "TC4D7 SoC"
	---help---
		Infineon AURIX TC4D7.

endchoice

config ARCH_TRICORE_CPU_COUNT
	int "TRICORE CPU count"
	default 1
	---help---
		Tricore CPU count

config TC4X_WDT
	bool "TC4x Watchdog Timer (WTU)"
	default n
	depends on WATCHDOG
	---help---
		Enable the TC4x Watchdog Timer lowerhalf (/dev/watchdogN).
		Supports all 7 WDT instances: CPU0-CPU5 and the System WDT.

		Note: WDT overflow raises an SMU alarm. Producing a system
		reset from that alarm needs SMU configuration (not yet
		supported); without it, overflow defaults to NMI.

config TC4X_WDT_FSPB
	int "SPB clock frequency (Hz)"
	default 100000000
	depends on TC4X_WDT
	---help---
		The SPB (System Peripheral Bus) clock frequency in Hz, used
		to compute WDT timeout periods. TC4x fSPB target is 100 MHz.

# I2C
menuconfig TC4X_I2C
	bool "TC4x I2C Master Driver"
	default n
	depends on I2C
	select ARCH_HAVE_I2CRESET
	---help---
		Enable I2C master driver for Infineon Aurix TC4x.

if TC4X_I2C

config TC4X_I2C_CLOCK_FREQ
	int "I2C peripheral source clock (fI2C) in Hz"
	default 100000000
	---help---
		The fI2C clock frequency from the CCU. Check your clock
		tree configuration. Default assumes 100 MHz.

config TC4X_I2C0
	bool "Enable I2C0"
	default n

if TC4X_I2C0

config TC4X_I2C0_FREQUENCY
	int "I2C0 default bus frequency"
	default 100000
	---help---
		Default I2C bus speed in Hz.
		standard mode (100 kHz)
		fast mode (400 kHz)

config TC4X_I2C0_PISEL
	int "I2C0 pin input select"
	default 1
	range 0 7
	---help---
		Selects which port pins provide SDA/SCL input signals.

endif # TC4X_I2C0

config TC4X_I2C1
	bool "Enable I2C1"
	default n

if TC4X_I2C1

config TC4X_I2C1_FREQUENCY
	int "I2C1 default bus frequency"
	default 100000

config TC4X_I2C1_PISEL
	int "I2C1 pin input select"
	default 0
	range 0 7

endif # TC4X_I2C1

config TC4X_I2C2
	bool "Enable I2C2"
	default n

if TC4X_I2C2

config TC4X_I2C2_FREQUENCY
	int "I2C2 default bus frequency"
	default 100000

config TC4X_I2C2_PISEL
	int "I2C2 pin input select"
	default 0
	range 0 7

endif # TC4X_I2C2

endif # TC4X_I2C
# SPI
config TC4X_ASCLIN_SPI
	bool "ASCLIN SPI master support"
	default n
	depends on SPI
	---help---
		Enable SPI master mode on ASCLIN modules.  The ASCLIN IP supports
		UART, LIN, and SPI modes.  This option enables the SPI lower-half
		driver that implements the NuttX spi_ops_s interface.

		Chip select is managed via GPIO, not the hardware ASLSO signal.
		Each bus instance requires its own ASCLIN module (separate from
		any ASCLIN used for UART console).

if TC4X_ASCLIN_SPI

config TC4X_ASCLIN3_SPI
	bool "ASCLIN3 as SPI bus 0 (mikroBUS pins)"
	default y
	---help---
		Use ASCLIN3 for SPI bus 0.  On a3g-tc4d7-lite this is wired to
		the mikroBUS connector SPI pins (verified against iLLD
		IfxAsclin_PinMap_TC4Dx_BGA292_COM):

		  MOSI: P15.6 (ASCLIN3.TX, ALT2)   - mikroBUS pin 6
		  MISO: P15.7 (ASCLIN3.RXA)        - mikroBUS pin 5
		  SCLK: P15.8 (ASCLIN3.SCLK, ALT6) - mikroBUS pin 4
		  CS:   P14.7 (GPIO)               - mikroBUS pin 3

		ASCLIN3 has no SLSO line on a header-accessible pin, so CS is
		driven as a plain GPIO from the SPI driver's select callback.

config TC4X_ASCLIN3_SPI_LOOPBACK
	bool "Enable loopback on ASCLIN3 SPI"
	default n
	depends on TC4X_ASCLIN3_SPI
	---help---
		Enable internal loopback (IOCR.LB) for ASCLIN3 SPI.  TX is
		internally connected to RX.  Useful for driver validation
		without external wiring.  Disable for real hardware use.

config TC4X_ASCLIN_SPI_CHARDEV
	bool "Register SPI character device"
	default y
	depends on SPI_DRIVER
	---help---
		Register /dev/spiN character device via spi_register().
		Enables userspace access through standard SPI ioctls.

endif # TC4X_ASCLIN_SPI

config TC4X_XSPI
	bool "xSPI controller"
	default n
	select XSPI
	select XSPI_DW_SSI
	select XSPI_DW_SSI_HAS_DDR
	select XSPI_DW_SSI_HAS_HYPERBUS
	select XSPI_DW_SSI_HAS_DMA
	select XSPI_DW_SSI_HAS_XIP
	---help---
		Enable the TC4xx xSPI controller. Provides SoC glue around
		the Synopsys DWC_SSI IP core driver for the single xSPI
		instance on TC4Dx devices.

if TC4X_XSPI

config TC4X_XSPI_SSI_CLK_HZ
	int "xSPI SSI_clk rate (Hz)"
	default 100000000
	---help---
		Input SSI_clk frequency feeding the xSPI controller. Used by
		the IP driver to compute the BAUDR divider. The default is a
		placeholder; set from the board clock tree.

config TC4X_XSPI_PORTSEL_GPIO
	bool "Route via GPIO pads (port 20) instead of HSFAST (port 16)"
	default n
	---help---
		Select GPIO pad routing for reduced functionality mode:
		SDR only, quad max, 25 MHz max, 3 V devices only.
		Useful for early bring-up on boards that expose port 20 pins
		on headers. Clear this for production HSFAST routing.

endif # TC4X_XSPI

