# QSPI
menuconfig TC4X_QSPI
	bool "TC4xx QSPI master driver"
	default n
	depends on SPI
        select SPI_DRIVER
        select SPI_EXCHANGE
        ---help---
                Enable the polled-mode QSPI master driver for TC4Dx.
                Provides a NuttX spi_ops_s lower-half built on top of the
                dedicated QSPI peripheral with hardware SLSO chip selects.
                Automatically enables the SPI character driver (/dev/spiN)
                and the spi_exchange() transfer operation.

if TC4X_QSPI

config TC4X_QSPI_FPER_HZ
        int "fPER clock feeding the QSPI module (Hz)"
        default 200000000
        ---help---
                Peripheral PLL clock frequency driving the QSPI module.
                TC4Dx boards typically run fPER at 200 MHz via the PER PLL
                (PERCCUCON0.CLKSELQSPI=2, QSPIDIV=1).  Adjust if a different
                clock source or divider is configured in tc4x_clockconfig.c.

if TC4X_QSPI0
config TC4X_QSPI0_DEFAULT_CS
	int "QSPI0 default hardware CS (SLSO index)"
	default 0
	range 0 15
config TC4X_QSPI0_MRIS
	int "QSPI0 MRIS pin input select"
	default 0
	range 0 7
config TC4X_QSPI0_TXIRQ
	int "QSPI0 TX interrupt node index (IRQ_QSPI0_TX)"
	default 280
config TC4X_QSPI0_RXIRQ
	int "QSPI0 RX interrupt node index (IRQ_QSPI0_RX)"
	default 281
config TC4X_QSPI0_ERIRQ
	int "QSPI0 Error interrupt node index (IRQ_QSPI0_ERR)"
	default 282
endif # TC4X_QSPI0

