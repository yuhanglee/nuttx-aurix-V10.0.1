#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

comment "Infineon AURIX TC4X Chip"

choice
	prompt "Infineon AURIX TC4X Chip selection"
	default TC4X_CHIP_TC4D7

config TC4X_CHIP_TC4D7
	bool "TC4D7 SoC"
	---help---
		Infineon AURIX TC4D7.

config TC4X_CHIP_TC487
	bool "TC487 SoC"
	---help---
		TC487 SoC

config TC4X_CHIP_TC499
	bool "TC499 SoC"
	---help---
		TC499 SoC

endchoice

config ARCH_TRICORE_CPU_COUNT
	int "TRICORE CPU count"
	default 1
	---help---
		Tricore CPU count

config TC4X_PERI_MMAP_OFFSET
	hex "Tricore base address"
	default 0x4400000 if TC4X_CHIP_TC4D7 || TC4X_CHIP_TC487
	default 0 if TC4X_CHIP_TC499

config TRICORE_STM_FREQUENCY
	int "STM clock frequency (Hz)"
	default 400000000 if TC4X_CHIP_TC487
	default 500000000
	---help---
		Frequency of the clock feeding the System Timer.  The tick
		period is derived from it, so a wrong value scales all
		timekeeping.

config TC4X_WDT
	bool "TC4x Watchdog Timer (WTU)"
	default n
	depends on WATCHDOG
	---help---
		Enable the TC4x Watchdog Timer lowerhalf (/dev/watchdogN).
		Supports all 7 WDT instances: CPU0-CPU5 and the System WDT.

		Note: WDT overflow raises an SMU alarm. Producing a system
		reset from that alarm needs SMU configuration (not yet
		supported); without it, overflow defaults to NMI.

config TC4X_WDT_FSPB
	int "SPB clock frequency (Hz)"
	default 100000000
	depends on TC4X_WDT
	---help---
		The SPB (System Peripheral Bus) clock frequency in Hz, used
		to compute WDT timeout periods. TC4x fSPB target is 100 MHz.

config TC4X_SMU
	bool "TC4x Safety Management Unit (SMU_SAFE) driver"
	default n
	---help---
		Enable the SMU_SAFE lower-half driver for the Infineon AURIX
		TC4x family.  The driver operates on SMU_SAFE0 by default;
		SMU_SAFE1 is available through the flat tc4x_smu_* API.

if TC4X_SMU

config TC4X_SMU_SAFE_INST
	int "SMU_SAFE partition to drive (0 = SAFE0, 1 = SAFE1)"
	default 0
	range 0 1
	---help---
		Selects which SMU_SAFE partition the driver operates on for
		hardware init, alarm arming, and the /dev/smu0 upper-half.

config TC4X_SMU_IRQ
	bool "SMU interrupt handler via SRC_SMU_SAFE"
	default n
	---help---
		Route IGCS0/1/2 alarm reactions to SRC_SMU_SAFE outputs and
		attach an ISR, and use the recovery timer as an escalation
		path.

config TC4X_SMU_WDT_REACTION
	int "WDT alarm default reaction code"
	default 2 if TC4X_SMU_IRQ
	default 6
	range 0 7
	---help---
		Reaction code written to WDT alarm bits (AGSF8[10..16])
		during tc4x_smu_initialize().  Individual alarms can be
		reconfigured at runtime via the SMUIOC_CONFIGALARM ioctl.

		  0 = NONE    (no reaction -- WDT overflow silently ignored)
		  2 = IGCS0   (interrupt via SRC_SMU_SAFE, requires TC4X_SMU_IRQ)
		  3 = IGCS1   (interrupt via SRC_SMU_SAFE, requires TC4X_SMU_IRQ)
		  4 = IGCS2   (interrupt via SRC_SMU_SAFE, requires TC4X_SMU_IRQ)
		  6 = RESET   (hardware-autonomous Application Reset, default
		               when TC4X_SMU_IRQ is not set)
		  7 = CPURST  (CPU reset only)

config TC4X_SMU_DISABLE_DOUBLE_RESET_GUARD
	bool "Disable SMU double reset guard (development only)"
	default n
	---help---
		The TC4x SMM latches an "SMU reset in progress" flag on the
		first SMU-triggered Application Reset and holds the chip in
		permanent reset if a second SMU reset occurs before power
		cycle, preventing runaway watchdog reset loops.

		Enable this to clear SMM.RSTSTATCLR.CLRSMUIRF at every boot
		so repeated WDT resets do not lock up the board during
		development and testing.  Do NOT enable this in production.

config TC4X_SMM_ARM_SMUSAFE0AR
	bool "Arm SMM.RSTTRIGCTRLA.SMUSAFE0AR for Application Reset"
	default n
	---help---
		Enable SMU_SAFE0 reset requests to generate an Application Reset.
		This is required when WDT alarms use the RESET reaction.

endif # TC4X_SMU

