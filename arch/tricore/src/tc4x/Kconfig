#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

comment "Infineon AURIX TC4X Chip"

choice
	prompt "Infineon AURIX TC4X Chip selection"
	default TC4X_CHIP_TC4D7

config TC4X_CHIP_TC4D7
	bool "TC4D7 SoC"
	---help---
		Infineon AURIX TC4D7.

endchoice

config ARCH_TRICORE_CPU_COUNT
	int "TRICORE CPU count"
	default 1
	---help---
		Tricore CPU count

config TC4X_WDT
	bool "TC4x Watchdog Timer (WTU)"
	default n
	depends on WATCHDOG
	---help---
		Enable the TC4x Watchdog Timer lowerhalf (/dev/watchdogN).
		Supports all 7 WDT instances: CPU0-CPU5 and the System WDT.

		Note: WDT overflow raises an SMU alarm. Producing a system
		reset from that alarm needs SMU configuration (not yet
		supported); without it, overflow defaults to NMI.

config TC4X_WDT_FSPB
	int "SPB clock frequency (Hz)"
	default 100000000
	depends on TC4X_WDT
	---help---
		The SPB (System Peripheral Bus) clock frequency in Hz, used
		to compute WDT timeout periods. TC4x fSPB target is 100 MHz.

# I2C
menuconfig TC4X_I2C
	bool "TC4x I2C Master Driver"
	default n
	depends on I2C
	select ARCH_HAVE_I2CRESET
	---help---
		Enable I2C master driver for Infineon Aurix TC4x.

if TC4X_I2C

config TC4X_I2C_CLOCK_FREQ
	int "I2C peripheral source clock (fI2C) in Hz"
	default 100000000
	---help---
		The fI2C clock frequency from the CCU. Check your clock
		tree configuration. Default assumes 100 MHz.

config TC4X_I2C0
	bool "Enable I2C0"
	default n

if TC4X_I2C0

config TC4X_I2C0_FREQUENCY
	int "I2C0 default bus frequency"
	default 100000
	---help---
		Default I2C bus speed in Hz.
		standard mode (100 kHz)
		fast mode (400 kHz)

config TC4X_I2C0_PISEL
	int "I2C0 pin input select"
	default 1
	range 0 7
	---help---
		Selects which port pins provide SDA/SCL input signals.

endif # TC4X_I2C0

config TC4X_I2C1
	bool "Enable I2C1"
	default n

if TC4X_I2C1

config TC4X_I2C1_FREQUENCY
	int "I2C1 default bus frequency"
	default 100000

config TC4X_I2C1_PISEL
	int "I2C1 pin input select"
	default 0
	range 0 7

endif # TC4X_I2C1

config TC4X_I2C2
	bool "Enable I2C2"
	default n

if TC4X_I2C2

config TC4X_I2C2_FREQUENCY
	int "I2C2 default bus frequency"
	default 100000

config TC4X_I2C2_PISEL
	int "I2C2 pin input select"
	default 0
	range 0 7

endif # TC4X_I2C2

endif # TC4X_I2C
