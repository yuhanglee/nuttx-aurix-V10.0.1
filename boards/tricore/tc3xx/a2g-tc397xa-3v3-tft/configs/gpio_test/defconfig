#
# gpio_test: NSH on UART0 + /dev/gpio0..2 (P22.0 out, P22.2 in pull-up,
# P22.3 in pull-down) for the GPIO driver bring-up smoke harness.
#
# CONFIG_DEV_NULL is not set
# CONFIG_DEV_ZERO is not set
CONFIG_ARCH="tricore"
CONFIG_ARCH_BOARD="a2g-tc397xa-3v3-tft"
CONFIG_ARCH_BOARD_A2G_TC397XA_3V3_TFT=y
CONFIG_ARCH_CHIP="tc3xx"
CONFIG_ARCH_CHIP_FAMILY_TC3XX=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARCH_TRICORE=y
CONFIG_BINFMT_DISABLE=y
CONFIG_BUILTIN=y
CONFIG_DISABLE_ENVIRON=y
CONFIG_DISABLE_MQUEUE=y
CONFIG_DISABLE_POSIX_TIMERS=y
CONFIG_DISABLE_PTHREAD=y
CONFIG_FLASH_SIZE=4194304
CONFIG_FLASH_START=0x80000000
CONFIG_FS_PROCFS=y
CONFIG_INIT_ENTRYNAME="main"
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_RAM_SIZE=5242880
CONFIG_RAM_START=0x90400000
CONFIG_RR_INTERVAL=1
CONFIG_SCHED_HPWORK=y
CONFIG_SCHED_HPWORKSTACKSIZE=4096
CONFIG_SYSLOG_CONSOLE=y
CONFIG_SYSTEM_NSH=y
CONFIG_TRICORE_ASCLINF_FREQUENCY=400000000
CONFIG_TRICORE_UART0=y
CONFIG_UART0_SERIAL_CONSOLE=y
CONFIG_USEC_PER_TICK=100
CONFIG_DEV_GPIO=y
CONFIG_BOARD_GPIO_TEST=y
CONFIG_TESTING_GPIO_TEST=y
