#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_TRIBOARD_TC4X7_COM

config ARCH_HAVE_LEDS
	bool
	default y

config BOARD_TC4X7_BUTTONS
	bool "Enable button support"
	default y
	---help---
		Enable support for the user push button on the
		AURIX TC4X7 Triboard. The software-visible button is wired
		to P33.11.

config ARCH_BUTTONS
	bool
	default y

config ARCH_IRQBUTTONS
	bool
	default y

if TC4XX_EGTM_PWM_LOWERHALF

menu "Triboard TC4x7 PWM channels to register"

config TC4X7_PWM_ANY
	bool

config TC4X7_PWM_CH0
	bool "/dev/pwm0  = P00.0  -> TOM0_0  (TOUT9,   sel 0x14)"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH1
	bool "/dev/pwm1  = P00.1  -> TOM0_1  (TOUT10,  sel 0x14)"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH2
	bool "/dev/pwm2  = P00.2  -> TOM0_2  (TOUT11,  sel 0x14)"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH3
	bool "/dev/pwm3  = P00.3  -> TOM0_3  (TOUT12,  sel 0x14)"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH4
	bool "/dev/pwm4  = P00.4  -> TOM0_11 (TOUT13,  sel 0x10)"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH5
	bool "/dev/pwm5  = P00.5  -> TOM0_12 (TOUT14,  sel 0x10)"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH6
	bool "/dev/pwm6  = P00.6  -> TOM0_13 (TOUT15,  sel 0x10)"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH7
	bool "/dev/pwm7  = P00.7  -> TOM0_14 (TOUT16,  sel 0x10)"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH8
	bool "/dev/pwm8  = P00.8  -> TOM0_15 (TOUT17,  sel 0x10)"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH9
	bool "/dev/pwm9  = P00.9  -> TOM0_9  (TOUT18,  sel 0x04)"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH10
	bool "/dev/pwm10 = P00.11 -> TOM0_10 (TOUT20,  sel 0x04)"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH11
	bool "/dev/pwm11 = P01.4  -> TOM1_8  (TOUT112, sel 0x05) [CLS1]"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH12
	bool "/dev/pwm12 = P01.5  -> TOM1_8  (TOUT113, sel 0x05) [CLS1]"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH13
	bool "/dev/pwm13 = P01.6  -> TOM1_9  (TOUT114, sel 0x05) [CLS1]"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH14
	bool "/dev/pwm14 = P01.7  -> TOM1_9  (TOUT115, sel 0x05) [CLS1]"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH15
	bool "/dev/pwm15 = P03.0  -> TOM2_8  (TOUT271, sel 0x15) [CLS2]"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH16
	bool "/dev/pwm16 = P03.2  -> TOM2_9  (TOUT273, sel 0x15) [CLS2]"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH17
	bool "/dev/pwm17 = P03.4  -> TOM2_10 (TOUT275, sel 0x15) [CLS2]"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH18
	bool "/dev/pwm18 = P03.11 -> TOM2_13 (TOUT282, sel 0x06) [CLS2]"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH19
	bool "/dev/pwm19 = P03.12 -> TOM2_14 (TOUT283, sel 0x15) [CLS2]"
	select TC4X7_PWM_ANY

config TC4X7_PWM_CH20
	bool "/dev/pwm20 = P03.14 -> TOM2_15 (TOUT285, sel 0x15) [CLS2]"
	select TC4X7_PWM_ANY

endmenu

endif # TC4XX_EGTM_PWM_LOWERHALF

endif
