#
# qspi_test: NSH on ASCLIN0 console + QSPI4 in internal loopback mode
# registered as /dev/spi4.
#
# Hardware connections (mikroBUS SPI header on a3g-tc4d7-lite):
#   MOSI : P22.0  QSPI4_MTSR_F  (ALT3, peripheral output)
#   MISO : P22.1  QSPI4_MRSTB_F (input, MRIS=1)
#   SCLK : P22.3  QSPI4_SCLK_F  (ALT3, peripheral output)
#   CS   : P23.1  QSPI4_SLSO6   (ALT3, peripheral output, active-low)
#
# Internal loopback (CONFIG_TC4XX_QSPI4_LOOPBACK=y) connects MTSR to MRST
# inside the QSPI4 module; no external jumper wire is required.
#
# To run the test:
#   nsh> spi_test -p /dev/spi4
#
CONFIG_ARCH="tricore"
CONFIG_ARCH_BOARD="a3g-tc4d7-lite"
CONFIG_ARCH_BOARD_A3G_TC4D7_LITE=y
CONFIG_ARCH_CHIP="tc4xx"
CONFIG_TRICORE_TOOLCHAIN_LLVM=y
CONFIG_ARCH_CHIP_FAMILY_TC4XX=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARCH_TRICORE=y
CONFIG_ARCH_TRICORE_CPU_COUNT=1
CONFIG_BINFMT_DISABLE=y
CONFIG_BUILTIN=y
CONFIG_DISABLE_ENVIRON=y
CONFIG_DISABLE_MQUEUE=y
CONFIG_DISABLE_POSIX_TIMERS=y
CONFIG_DISABLE_PTHREAD=y
CONFIG_FLASH_SIZE=4194304
CONFIG_FLASH_START=0x80000000
CONFIG_FS_PROCFS=y
CONFIG_INIT_ENTRYNAME="main"
CONFIG_INIT_ENTRYPOINT="nsh_main"
CONFIG_NSH_ARCHINIT=y
CONFIG_NSH_BUILTIN_APPS=y
CONFIG_RAM_SIZE=5242880
CONFIG_RAM_START=0x90400000
CONFIG_RR_INTERVAL=1
CONFIG_SCHED_HPWORK=y
CONFIG_SCHED_HPWORKSTACKSIZE=4096
CONFIG_SYSLOG_CONSOLE=y
CONFIG_SYSTEM_NSH=y
CONFIG_TRICORE_UART0=y
CONFIG_UART0_SERIAL_CONSOLE=y
CONFIG_USEC_PER_TICK=100

# SPI subsystem
CONFIG_SPI=y

# TC4Dx QSPI4 -- mikroBUS SPI header, internal loopback
# fPER = 200 MHz (PER PLL K3 / 1 via PERCCUCON0.CLKSELQSPI=2, QSPIDIV=1)
# default 1 MHz SPI clock (set by spi_test at run time)
CONFIG_TC4XX_QSPI=y
CONFIG_TC4XX_QSPI4=y
CONFIG_TC4XX_QSPI4_LOOPBACK=y

# spi_test smoke test application
CONFIG_TESTING_SPI_TEST=y
