#
# Secondary CPUs (1..5) in the TC4D7 AMP setup: minimal hello+idle.
# Build with EXTRAFLAGS="-DCPU=N" (N = 1..5).  Each CPU prints
# "[CPU N] AMP secondary alive" via polled writes to shared ASCLIN0
# and parks the idle thread.  CPU 0 owns the IRQ-driven serial
# driver; secondaries skip uart_register entirely.
#
# CONFIG_DEV_NULL is not set
# CONFIG_DEV_ZERO is not set
# CONFIG_STANDARD_SERIAL is not set
CONFIG_ARCH="tricore"
CONFIG_ARCH_BOARD="a3g-tc4d7-lite"
CONFIG_ARCH_BOARD_A3G_TC4D7_LITE=y
CONFIG_ARCH_CHIP="tc4xx"
CONFIG_ARCH_CHIP_FAMILY_TC4XX=y
CONFIG_ARCH_INTERRUPTSTACK=2048
CONFIG_ARCH_STACKDUMP=y
CONFIG_ARCH_TRICORE=y
CONFIG_ARCH_TRICORE_CPU_COUNT=1
CONFIG_BINFMT_DISABLE=y
CONFIG_DISABLE_ENVIRON=y
CONFIG_DISABLE_MQUEUE=y
CONFIG_DISABLE_POSIX_TIMERS=y
CONFIG_DISABLE_PTHREAD=y
CONFIG_FLASH_SIZE=4194304
CONFIG_FLASH_START=0x80000000
CONFIG_INIT_ENTRYNAME="main"
CONFIG_INIT_ENTRYPOINT="amp_secondary_main"
CONFIG_NSH_ARCHINIT=y
CONFIG_RAM_SIZE=5242880
CONFIG_RAM_START=0x90400000
CONFIG_RR_INTERVAL=1
CONFIG_SYSLOG_NONE=y
CONFIG_TRICORE_UART0=y
CONFIG_UART0_SERIAL_CONSOLE=y
CONFIG_USEC_PER_TICK=100
