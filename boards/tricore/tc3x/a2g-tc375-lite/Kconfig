#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#

if ARCH_BOARD_A2G_TC375_LITE

config BOARD_PHY_AUTONEG
	bool "Ethernet PHY autonegotiation"
	default y
	depends on TC3XX_GETH

config BOARD_CAN_TLE9251V_STB_PIN
	bool "Drive TLE9251V CAN_STB low at boot"
	default y
	depends on CAN
	---help---
		The AURIX lite Kit V2 wires the on-board TLE9251V CAN
		transceiver standby control to P20.6.  The transceiver
		boots in standby; the CPU must drive P20.6 low to enable
		normal operating mode before any frame leaves the bus.

config BOARD_USER_LED_GPIO
	bool "Register on-board user LED1 (P00.5) as /dev/gpio0"
	default n
	depends on DEV_GPIO
	---help---
		Registers Lite Kit user LED1 (P00.5, active-low) as /dev/gpio0,
		output with init level HIGH so the LED is off at boot.

endif
