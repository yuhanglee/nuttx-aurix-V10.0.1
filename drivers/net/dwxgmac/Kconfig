#
# For a description of the syntax of this configuration file,
# see the file kconfig-language.txt in the NuttX tools repository.
#
menuconfig NET_DWXGMAC
	bool "Synopsys Design Ware XGMAC support"
	default n
	---help---
		Enable designware xgmac Ethernet driver.

if NET_DWXGMAC

config DWXGMAC_NETHERNET
    int "Number of XGMAC Ethernet interfaces"
    default 1

config DWXGMAC_BASE
    hex "XGMAC MAC base address"
    default 0xf9010000

config DWXGMAC_NUM_RX_DMA_DESCRIPTORS
    int "Number of RX DMA descriptors"
    default 8

config DWXGMAC_NUM_TX_DMA_DESCRIPTORS
    int "Number of TX DMA descriptors"
    default 8

config DWXGMAC_DMA_IRQ
    int "XGMAC DMA interrupt number"
    default 0

config NET_DWXGMAC_MDIO
	bool "XGMAC MDIO driver"
	default n
	---help---
		Enable MDIO bus for designware xgmac Ethernet driver.

config DWXGMAC_QOS
	bool "XGMAC based on QOS driver"
	default n
	---help---
		Enable QOS version of designware xgmac Ethernet driver.

config NET_DWXGMAC_MAC_LOOPBACK
	bool "Enable MAC-internal loopback (debug only)"
	default n
	---help---
		Sets MAC_RX_CONFIGURATION.LM so the MAC loops every transmitted
		frame back into its own receive path, bypassing the MII/RMII
		PHY pads.  Use this only to isolate MAC vs. PHY/board issues.

config NET_DWXGMAC_DMA_SECTION
	string "Linker section for DMA descriptors and RX buffers"
	---help---
		If non-empty, place the DMA descriptors and RX buffer pool
		into the named linker section.  Required on systems where the
		Ethernet DMA peripheral cannot access the default .bss memory
		(for example AURIX TriCore, where .bss lives in CPU-local DSPR
		but the GETH DMA only reaches LMU/system RAM).

endif #NET_DWXGMAC
